# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# node
node_modules/
.next/
next-env.d.ts

# env & editors
.env
.env*.local
.idea/
.DS_Store

# local AWS CLI inputs that hold personal data (e.g. the budget alert email)
budget.json
budget-notify.json
# `make aws-agendas` output (saved agendas), deleted after printing
.aws-agendas.json

# terraform (keep .terraform.lock.hcl in git)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.auto.tfvars.secret
# secrets and email addresses for local runs, written from .env
infra/secrets.auto.tfvars
# gcp/ (Lab 9): covered by the rules above, listed for clarity. Not
# gcp/.terraform*, which would also ignore gcp/.terraform.lock.hcl.
gcp/.terraform/
gcp/*.tfstate
gcp/*.tfstate.*
gcp/*.tfplan
