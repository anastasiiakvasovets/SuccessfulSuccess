# Copy to .env before running `docker compose up`.

# --- database ---------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=meetings
POSTGRES_PORT=5432

# --- backend ----------------------------------------------------------------
BACKEND_PORT=8000
APP_TIMEZONE=Europe/Kyiv
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_START=true

# --- sign-in (Cognito) ------------------------------------------------------
# Paste the output of `make aws-auth-env` here (it reads the Terraform outputs of
# infra/auth.tf; run `make infra-init` once first), then restart the stack. Both the API and the frontend read these; without them
# nobody can sign in.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false

# --- frontend ---------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- aws --------------------------------------------------------------------
# Credentials used by the `aws-*` make targets. Fill these in your own .env
# (gitignored) — never here. AWS_SESSION_TOKEN is only needed for temporary
# credentials (SSO / assumed roles); leave it empty for a plain IAM user key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Prefix applied to the names of every resource the make targets create, and
# the value of the PROJECT_NAME tag every one of them carries.
PROJECT_NAME=successfulsuccess
# Master password for the Aurora cluster created by `make aws-deploy-backend`.
# 8-41 characters, letters/digits/underscore/dash only (it is embedded in the
# connection URL). Changing it after the first deploy resets the database user.
AWS_DB_PASSWORD=
# Origins allowed to call the deployed API. Empty follows the frontend: its
# CloudFront URL (plus the custom domain), or * until the frontend exists. Set a
# comma-separated list or * to override.
AWS_CORS_ORIGINS=
# The user pool is Terraform (infra/auth.tf): domain_prefix and google_client_id
# are in infra/terraform.tfvars, and the Google client's "Authorized redirect
# URI" is `terraform -chdir=infra output -raw google_redirect_uri`. The secret
# is the Sensitive workspace variable google_client_secret in HCP Terraform;
# keep a copy here only for infra/secrets.auto.tfvars (gitignored, local runs).
# Never commit the secret.
GOOGLE_CLIENT_SECRET=
# Optional custom domain for the CloudFront site, e.g. app.example.com. Leave
# empty to use the distribution's own *.cloudfront.net name. Run
# `make aws-frontend-cert` once to issue its certificate (in us-east-1).
AWS_FRONTEND_DOMAIN=
# CloudFront pricing: FREE puts the distribution on the flat-rate Free plan
# ($0/month, 1M requests + 100 GB, no overage charges). AWS refuses it while the
# account is on the AWS Free Tier; use PAY_AS_YOU_GO there.
AWS_CLOUDFRONT_PLAN=FREE
# --- weekly report (Lab 5) ---------------------------------------------------
# SES sends the report from REPORT_SENDER to REPORT_RECIPIENT: the Terraform
# variables sender_email / report_recipient (HCP workspace variables; here only
# for infra/secrets.auto.tfvars). Terraform creates an SES identity for each, and
# SES mails a verification link to each address; click it before the first
# report. While the account is in the SES sandbox, both must be verified. They
# may be the same.
REPORT_SENDER=
REPORT_RECIPIENT=
# --- agenda parser (Lab 6) ----------------------------------------------------
# Which model parses pasted agendas. anthropic: the Anthropic Messages API on
# Bedrock (bedrock-mantle), model ids like anthropic.claude-opus-5-5.
# converse: the Bedrock Converse API, e.g.
# PARSER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0. fake: no model is
# called, for building the feature before Bedrock access works.
# anthropic_api: the Claude API directly, PARSER_MODEL=claude-opus-5-5, with the
# key below (the deployed parser reads it from SSM /<PROJECT_NAME>/anthropic-api-key).
PARSER_PROVIDER=anthropic
PARSER_MODEL=anthropic.claude-opus-5-5
# Only for PARSER_PROVIDER=anthropic_api, locally. Never commit a real key.
ANTHROPIC_API_KEY=
# The deployed parser's URL (`make aws-ai-url`), for the local frontend; the
# parser allows http://localhost:3000. Empty hides Paste an agenda.
PARSER_URL=
